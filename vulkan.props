<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <VulkanDir>$(VK_SDK_PATH)\</VulkanDir>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup Condition="Exists('$(VulkanDir)')">
    <ClCompile>
      <PreprocessorDefinitions>FPD_WITH_VULKAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(VulkanDir)Include</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="VulkanDir">
      <Value>$(VulkanDir)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>